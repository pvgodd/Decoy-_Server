# 운영 환경변수 예시. 복사해서 .env 로 쓰거나 systemd EnvironmentFile 로 지정하세요.
# .env 는 절대 커밋하지 마세요(.gitignore 에 포함됨).

# --- 서버 ---
SERVER_PORT=8080
APP_BASE_URL=https://portal.example.com
APP_BRAND=파트너 포털
APP_COMPANY=우리회사

# --- 데이터베이스 (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/partner_portal
DB_USERNAME=portal
DB_PASSWORD=change-this-password
# 최초 기동 시 테이블 자동 생성/갱신. 운영 안정화 후에는 validate 권장.
JPA_DDL_AUTO=update

# --- 최초 관리자 계정 ---
# ADMIN_PASSWORD 를 비워두면 최초 기동 시 랜덤 생성되어 로그에 1회 출력됩니다.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=

# --- 메일 (비밀번호 초기화 링크 발송) ---
# 설정하지 않으면 초기화 링크가 서버 로그에만 기록됩니다.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
